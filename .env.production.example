# Railway provides DATABASE_URL when a MySQL service is attached.
DATABASE_URL=mysql://user:password@host:3306/database

# Required for Manus OAuth/session integration.
MANUS_PROJECT_ID=your-production-project-id
MANUS_JWT_SECRET=generate-a-long-random-secret
MANUS_OAUTH_API_URL=https://oauth.manus.im
MANUS_OAUTH_PORTAL_URL=https://auth.manus.im
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=

# Optional only after PayPay OPA production credentials and contracts are approved.
PAYPAY_OPA_ENV=production
PAYPAY_API_KEY=
PAYPAY_API_SECRET=
PAYPAY_MERCHANT_ID=
PAYPAY_USER_AUTH_ENCRYPTION_KEY=
